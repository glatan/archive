/target
# fuzz の failure artifact / corpus は ignore するが、podman -v マウント用に
# ディレクトリ自体は .gitkeep で残す
fuzz/failures/*
!fuzz/failures/.gitkeep
fuzz/corpus/*
!fuzz/corpus/.gitkeep
# Claude Code エージェント作業ディレクトリ
.claude/worktrees/
# 仕様書キャッシュ (manifest.json はバージョン管理、ダウンロード済みファイルは除外)
docs/spec/sources/*.txt
docs/spec/sources/*.md
docs/spec/sources/*.htm
docs/spec/sources/*.html
docs/spec/sources/*.pdf
docs/spec/sources/*.c
docs/spec/sources/*.rst
docs/spec/sources/*.tex
docs/spec/sources/*.h
docs/spec/sources/lzrw45_covering

# local work files (plans, reference trees, oracle builds)
/.local/
